{
    "triggers":[
                {
                    "name":"fullme",
                    "sync":true,  
                    "unique":true,
                    "autoRegister":true,
                    "matcher":{
                        "type":"Equals",
                        "expression":"fullme"
                    },
                    "action":{
                        "type":"RegisterAction",
                        "expression":"fullme-url"
                    },
                    "type":"outbound",
                    "remainningCount":-1
                },
                {
                    "name":"fullme-url",
                    "sync":false,  
                    "unique":true,
                    "autoRegister":false,
                    "matcher":{
                        "type":"StartWith",
                        "expression":"http://fullme.pkuxkx.net/"
                    },
                    "action":{
                        "type":"FullmeShowAction",
                        "expression":"l",
                        "params":{
                            "baseUrl":"http://fullme.pkuxkx.net/"
                        }
                    },
                    "type":"inbound",
                    "remainningCount":1
                }
    ]
}